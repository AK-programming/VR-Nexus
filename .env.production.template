# VR-Nexus — Production Environment Variables
#
# Copy this file to .env.production and fill in every placeholder.
#
#   cp .env.production.template .env.production
#   nano .env.production          # or any editor
#
# NEVER commit .env.production to Git — it contains secrets.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tender_admin
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=tender_analysis
DATABASE_URL=postgresql+psycopg://tender_admin:<same-password-as-above>@postgres:5432/tender_analysis

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Auth -------------------------------------------------------------------
JWT_SECRET_KEY=<generate-a-64-char-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# --- Storage (inside the container) -----------------------------------------
STORAGE_ROOT=/data/storage
TENDER_STORAGE_DIR=/data/storage/tenders
LIBRARY_STORAGE_DIR=/data/storage/library
OUTPUT_STORAGE_DIR=/data/storage/outputs
MAX_UPLOAD_MB=100

# --- Embeddings -------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- LLM (Anthropic) -------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
LLM_ENABLED=true

# --- Chunking ---------------------------------------------------------------
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Duplicate detection ----------------------------------------------------
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=https://yourdomain.com
PASSWORD_RESET_URL_BASE=https://yourdomain.com

# --- App --------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- Support email ----------------------------------------------------------
SUPPORT_EMAIL=<your-support-email>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-app-password>
SMTP_FROM=<your-smtp-from-email>
SMTP_USE_TLS=true
