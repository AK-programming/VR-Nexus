# Root dev-orchestration deps (concurrently). The frontend has its own
# myapp/.gitignore for its node_modules.
/node_modules/

# Local secrets — never commit filled-in env files.
.env
backend/.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
backend/.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Frontend build output
myapp/dist/
myapp/dist-ssr/
*.tsbuildinfo

# Runtime uploads and generated files
backend/storage/

# Logs
*.log
logs/

# Editor and local agent tooling (not part of the application)
.vscode/
.claude/

# OS
.DS_Store
Thumbs.db
