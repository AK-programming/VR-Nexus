# ===========================================================================
# VR-Nexus .gitignore
# ===========================================================================

# --- Environment files (contain secrets) ------------------------------------
.env
.env.production
.env.local
.env.*.local
backend/.env

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
*.so

# --- Node / Frontend --------------------------------------------------------
node_modules/
myapp/node_modules/
myapp/dist/
myapp/.vite/
*.tsbuildinfo

# --- Storage (local dev uploads, not tracked) -------------------------------
storage/
/data/

# --- IDE / Agent Tooling ----------------------------------------------------
.vscode/
.idea/
.claude/
Claude outputs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker -----------------------------------------------------------------
# Docker volumes are not in the repo, but local overrides might be.
docker-compose.override.yml

# --- Logs -------------------------------------------------------------------
*.log
logs/

# --- Test / Coverage --------------------------------------------------------
.coverage
htmlcov/
.pytest_cache/
