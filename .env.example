# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=evidence
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=evidence_library
# Host/port resolve to the compose service names; override only outside Docker.
DATABASE_URL=postgresql+psycopg://evidence:change_me_in_env@postgres:5432/evidence_library

# --- Redis (Celery broker + progress pub/sub) -------------------------------
REDIS_URL=redis://redis:6379/0

# --- Embeddings (LIB-IDX-05) ------------------------------------------------
# Local ONNX model, no API key, no network at inference.
# Changing the model means changing EMBEDDING_DIM *and* running a new Alembic
# migration to alter the vector column — the two must always agree.
#
# 768 is fixed by WBS 1.1.3: chunks.embedding is vector(768) to match Google
# text-embedding-004. The chat key serves no embedding models, so we match that
# dimension locally with bge-base (the 768-dim sibling of bge-small) instead.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- LLM: answer generation (/ask) + parsing and auto-tagging fallback -------
# Chat only — this endpoint serves no /v1/embeddings channel, which is why
# embeddings run locally above. Paste a real key into .env, never in here.
OPENAI_API_KEY=
OPENAI_MODEL=claude-opus-4-8
OPENAI_BASE_URL=https://api.anthropic.com/v1/
# Sent as the User-Agent on every chat call. Identify this application; do not
# impersonate another client.
OPENAI_USER_AGENT=vr-nexus-evidence-library/0.1
# Leave the LLM off to run fully offline. Parsing falls back to heuristics and
# retrieval is unaffected, but /ask cannot generate an answer.
LLM_ENABLED=true

# --- Chunking (LIB-IDX-05) --------------------------------------------------
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# --- Uploads ----------------------------------------------------------------
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=100

# --- Duplicate detection (LIB-UI-06) ----------------------------------------
# Cosine similarity at or above this yields a soft "near-duplicate" warning.
# Exact sha256 collisions are always a hard block, regardless of this value.
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# --- App --------------------------------------------------------------------
# Comma-separated. Section 8's Next.js dev server runs on 3000.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000
LOG_LEVEL=INFO
