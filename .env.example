# ===========================================================================
# Backend configuration — VR-Nexus, single merged backend.
#
# WHERE THIS FILE GOES. Two destinations, same contents, because the two ways
# of running the backend look for it in different places:
#
#   Docker:  copy to  ./.env            (repo root, beside docker-compose.yml)
#   Native:  copy to  ./backend/.env    (beside app/, alembic.ini)
#
# The reason is that docker-compose reads `env_file: .env` relative to the
# compose file and injects the values as container environment variables, while
# `uvicorn app.main:app` run from backend/ has pydantic-settings read
# `env_file=".env"` relative to the *process working directory*. If you use both
# paths, keep the two copies in step — nothing checks that they agree.
#
# Never commit a filled-in .env. This file is the template; .env is gitignored.
#
# THE FRONTEND HAS ITS OWN. myapp/.env.example configures the Vite dev server
# (VITE_API_BASE_URL and friends). Nothing here affects the React app.
#
# FIVE SETTINGS BELOW HAVE NO DEFAULT. DATABASE_URL, REDIS_URL,
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND and JWT_SECRET_KEY are declared on
# Settings with no fallback value, so the app does not start without them — it
# raises a pydantic ValidationError at import time, before the first request.
# That is deliberate: a backend silently running on a default secret key is
# worse than one that refuses to boot. They are marked (REQUIRED) below.
#
# ANYTHING NOT LISTED HERE IS IGNORED, NOT REJECTED. Settings is configured with
# extra="ignore", so a typo'd or obsolete key is silently swallowed rather than
# flagged. STORAGE_DIR is the one to watch for: it was the old flat backend's
# single storage setting, it no longer exists, and setting it does nothing at
# all. Use the four *_STORAGE_DIR / STORAGE_ROOT settings instead.
# ===========================================================================


# --- Postgres container credentials -----------------------------------------
# Read by docker-compose only, to initialise the database on first start. The
# application never reads these — it reads DATABASE_URL. They exist as separate
# values because the postgres image wants them separately. Keep them consistent
# with DATABASE_URL below or the API will hold a valid DSN for a database that
# was created under a different name.
#
# These defaults match setup_database.sql, so the Docker path and the native
# install describe the same database.
POSTGRES_USER=tender_admin
POSTGRES_PASSWORD=tender_dev_password
POSTGRES_DB=tender_analysis


# --- Database (REQUIRED) ----------------------------------------------------
# `postgres` is the compose service name and only resolves inside the Docker
# network. Running the API on the host against compose Postgres, use:
#   postgresql+psycopg://tender_admin:tender_dev_password@127.0.0.1:5432/tender_analysis
#
# The driver must be psycopg (v3), not psycopg2 — requirements.txt pins
# psycopg[binary]==3.2.3 and psycopg2 is not installed.
#
# PGVECTOR IS A PREREQUISITE, not something migrations create. chunks.embedding
# and tender_chunks.embedding are both vector(768), so `CREATE EXTENSION vector`
# has to have run in this database before `alembic upgrade head`. Docker handles
# it via docker/init-extensions.sql on first start; a native install needs
# setup_database.sql (and pgvector actually built into that Postgres).
DATABASE_URL=postgresql+psycopg://tender_admin:tender_dev_password@postgres:5432/tender_analysis


# --- Redis (REQUIRED) -------------------------------------------------------
# Serves three jobs: Celery broker, Celery result backend, and the pub/sub
# channels behind both WebSocket progress feeds.
#
# On the host, `redis` becomes 127.0.0.1:
#   redis://127.0.0.1:6379/0
#
# The three URLs are separate settings so a deployment can split them across
# instances later; pointing all three at the same Redis is normal and fine.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# --- Auth (JWT_SECRET_KEY is REQUIRED) --------------------------------------
# Generate a real one — do not ship the placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing this value invalidates every issued access and refresh token, so
# every signed-in user is logged out. That is the intended emergency response if
# it ever leaks.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 1440 minutes = 24 hours. The frontend refreshes automatically on a 401, so a
# shorter window here costs nothing in usability.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Lockout after this many consecutive failures, for this many minutes. The API
# returns 423 while locked, and 401 with a deliberately generic message
# otherwise, so a caller cannot tell a wrong password from an unknown account.
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_MINUTES=15


# --- Storage ----------------------------------------------------------------
# Four roots, not one. Tender uploads, library assets and generated output
# folders have different lifetimes, and the tender pipeline and the library
# indexer resolve paths independently.
#
# The values below are container paths matching the storage_data volume in
# docker-compose.yml. Running natively, use real local directories: a relative
# path like ./storage resolves against each process's working directory, so the
# API and the Celery worker must be started from the same place or give absolute
# paths. They must agree — one writes the upload, the other reads it back to
# parse it, and a mismatch shows up as a file-not-found deep in a Celery task
# rather than as a configuration error.
STORAGE_ROOT=/data/storage
TENDER_STORAGE_DIR=/data/storage/tenders
LIBRARY_STORAGE_DIR=/data/storage/library
OUTPUT_STORAGE_DIR=/data/storage/outputs
MAX_UPLOAD_MB=100


# --- Embeddings (LIB-IDX-05) ------------------------------------------------
# Local ONNX inference through fastembed. No API key, no network call at index
# time. The model is ~130MB and downloads on first use; compose caches it in the
# fastembed_cache volume so a rebuild does not re-download it.
#
# THESE THREE MOVE TOGETHER. 768 is not a free parameter — chunks.embedding and
# tender_chunks.embedding are declared vector(768) in the migration chain.
# Changing the model means changing EMBEDDING_DIM *and* writing an Alembic
# migration to alter both columns. embeddings.py checks the width the model
# actually returns and raises with that instruction rather than letting pgvector
# reject the insert later.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768


# --- LLM: one provider for the whole app (Anthropic Claude) -----------------
# Used by: tender requirement extraction + metadata (app/services/extraction.py),
# the Evidence Library's auto-tagging and parser fallback, and its grounded Ask.
# Not used for embeddings (those are local, see above) — one ANTHROPIC_API_KEY
# covers everything else in the app.
#
# Left empty on purpose. With no key, Settings.llm_available is False, every
# library LLM path degrades to heuristics, and the tender pipeline fails at the
# extraction stage with a message naming it. Fill it in as a deliberate
# decision, bearing in mind real tender and client documents are what get sent.
#
# Any OpenAI-compatible chat endpoint works, because llm.py and extraction.py
# hand base_url straight to the `openai` client — this does not have to be
# Anthropic's own endpoint if you point it elsewhere.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# The "reasoning" model: only the Evidence Library's grounded Ask uses this one
# directly. Claude retires dated model ids periodically — a 404 "model not
# found" here means it is time to bump this to whatever is current.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# The cheap-tier model: tender extraction, library auto-tagging, and parser
# fallback all use THIS one instead of ANTHROPIC_MODEL above. Those are
# high-volume (100+ calls per tender) mechanical "copy this text into these
# JSON fields" work with no judgment call in it, so a fast/cheap model does the
# job as reliably as the reasoning model at a fraction of the per-token cost.
# Same ANTHROPIC_API_KEY — this is not a second key.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_USER_AGENT=
# Set false to guarantee no chat call is ever made, even if a key is present.
LLM_ENABLED=true
# Tender chunks extracted concurrently per run. Higher = faster on a paid tier;
# lower (e.g. 2) if you see 429/rate-limit responses in the worker log.
EXTRACTION_CONCURRENCY=4


# --- Chunking (LIB-IDX-05) --------------------------------------------------
# Evidence Library only: ~800-token windows with 100 tokens of overlap, never
# crossing a section boundary. The tender chunker is a separate module with its
# own larger page-bounded windows and does not read these.
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100


# --- Duplicate detection (LIB-UI-06) ----------------------------------------
# Cosine similarity at or above this raises a soft near-duplicate warning the
# user can override. An exact sha256 match is always a hard block regardless of
# this value, so lowering it only makes the advisory warnings noisier.
DUPLICATE_SIMILARITY_THRESHOLD=0.95


# --- OCR (optional) ---------------------------------------------------------
# Only needed for scanned PDFs with no extractable text layer. Leave unset and
# pytesseract resolves `tesseract` from PATH — which is what you want in Docker,
# since backend/Dockerfile installs tesseract-ocr and tesseract-ocr-eng. Without
# Tesseract available, scanned pages are skipped with a warning rather than
# failing the document.
#
# ONE GOTCHA: this is read with os.getenv() in pdf_extraction.py, not through
# Settings. os.getenv only sees the real process environment, and
# pydantic-settings does not export .env values into it. So this line works
# under docker-compose (env_file injects real environment variables) but is
# INERT in backend/.env for a native uvicorn run — set it in your shell instead.
# Everything else in this file goes through Settings and works either way.
#
# Windows example (note the real path is verified on startup; a wrong one logs a
# warning and falls back to PATH rather than crashing):
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=


# --- App --------------------------------------------------------------------
# Comma-separated allowed origins. 5173 is this project's Vite dev server, 3000
# is Section 8's Next.js. Tighten this in production — it is the only thing
# standing between the API and a browser on another origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
ENVIRONMENT=development
DEBUG=true


# --- Declared but unused ----------------------------------------------------
# GOOGLE_API_KEY, LLM_LIGHT_MODEL and LLM_HEAVY_MODEL are fields on Settings but
# nothing reads them. They are left from the original plan to use Gemini, before
# the team switched library embeddings to local fastembed and tender extraction
# to Anthropic. Listed here so their presence in config.py is not mistaken for a
# configuration step you have missed.
#
# LOG_LEVEL appeared in the previous version of this file and is not a Settings
# field either — it was silently ignored. Logging is configured in code.


# --- Support email (tender failure -> support team) -------------------------
# When a tender analysis fails, a non-technical user can press "Contact
# technical support" on the Processing page's error log. The backend emails the
# full error (reason + stack) to SUPPORT_EMAIL and shows the user a calm
# "we're on it, please wait 3-4 days" message.
#
# To ENABLE sending you must set SMTP_USERNAME and SMTP_PASSWORD. Defaults below
# target Gmail. For a Gmail sender:
#   1. Turn on 2-Step Verification on the sending Google account.
#   2. Create an App Password (Google account -> Security -> App passwords).
#   3. Put the 16-character App Password (no spaces) in SMTP_PASSWORD, and the
#      full gmail address in SMTP_USERNAME.
# With either credential blank, the button still appears but pressing it tells
# the user support isn't set up and the UI offers a plain mailto: link instead.
SUPPORT_EMAIL=engrak2155@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Envelope From; defaults to SMTP_USERNAME when blank. Gmail rewrites it anyway.
SMTP_FROM=
SMTP_USE_TLS=true
