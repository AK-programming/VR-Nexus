# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database (native PostgreSQL install - see README.md Section 3) ---
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/tender_system
# --- Redis / Celery ---
# NOT NEEDED for Task 1.1 or 1.2. These are only used once we build the
# background pipeline (Stage 1-4 processing, Task 7.1 progress tracking).
# Leave as-is for now; we'll install Redis and revisit this when we get there.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth (Task 1.2 - generate your own secret, this is a placeholder) ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# --- File storage (local filesystem per implementation plan) ---
STORAGE_ROOT=./storage
TENDER_STORAGE_DIR=./storage/tenders
LIBRARY_STORAGE_DIR=./storage/library
OUTPUT_STORAGE_DIR=./storage/outputs

# --- AI providers (used later by the extraction/matching modules, not needed for Task 1.1) ---
GOOGLE_API_KEY=
LLM_LIGHT_MODEL=gemini-1.5-flash
LLM_HEAVY_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# --- App ---
ENVIRONMENT=development
DEBUG=true
